{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch AquaFabz (Chrome - localhost:3000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start AquaFabz Dev Server"
    },
    {
      "name": "Launch AquaFabz (Edge - localhost:3000)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start AquaFabz Dev Server"
    }
  ]
}
